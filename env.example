# ═══════════════════════════════════════════════════════════════
# UniTalks Backend Configuration
# ═══════════════════════════════════════════════════════════════

# Server
PORT=8080
NODE_ENV=development

# Auth
JWT_SECRET=your-super-secret-jwt-key-change-in-production

# CORS - comma-separated origins (use * for all in dev)
CORS_ORIGIN=http://localhost:3000

# Redis (optional - enables shared state for clustering)
USE_REDIS=false
REDIS_URL=redis://localhost:6379

# HTTPS (production)
HTTPS_ENABLED=false
SSL_CERT_PATH=/path/to/fullchain.pem
SSL_KEY_PATH=/path/to/privkey.pem

# TURN/Coturn (WebRTC NAT traversal)
TURN_HOST=
TURN_PORT=3478
TURN_TLS=true
TURN_SECRET=
STUN_URLS=stun:stun.l.google.com:19302,stun:stun1.l.google.com:19302

# Rate limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100
WS_RATE_LIMIT_WINDOW_MS=60000
WS_RATE_LIMIT_MAX=60

# Support
SUPPORT_EMAIL=support@unitalks.example.com

# ═══════════════════════════════════════════════════════════════
# Frontend Configuration
# ═══════════════════════════════════════════════════════════════

REACT_APP_WEB3FORMS_KEY=your_web3forms_key_here
REACT_APP_API_URL=http://localhost:8080
